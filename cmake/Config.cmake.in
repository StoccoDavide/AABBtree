@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Eigen: an installed Eigen is preferred; otherwise the Eigen headers bundled
# with AABBtree are used (they are bundled only when Eigen was downloaded while
# configuring AABBtree)
find_package(Eigen3 3.4 QUIET NO_MODULE)
if(NOT TARGET Eigen3::Eigen)
  set(_aabbtree_eigen_dir "@AABBTREE_CONFIG_EIGEN_DIR@")
  if(_aabbtree_eigen_dir AND EXISTS "${_aabbtree_eigen_dir}/Eigen/Core")
    add_library(Eigen3::Eigen INTERFACE IMPORTED)
    set_target_properties(Eigen3::Eigen PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${_aabbtree_eigen_dir}")
  else()
    set(AABBtree_FOUND FALSE)
    set(AABBtree_NOT_FOUND_MESSAGE "AABBtree requires Eigen3 >= 3.4, which was not found")
    return()
  endif()
endif()

# OpenMP is needed only if AABBtree was configured with it. The module shipped
# with the package also finds libomp when the compiler is Apple Clang.
set(AABBTREE_USE_OPENMP @AABBTREE_USE_OPENMP@)
if(AABBTREE_USE_OPENMP AND NOT TARGET OpenMP::OpenMP_CXX)
  include("${CMAKE_CURRENT_LIST_DIR}/AABBtreeOpenMP.cmake")
  if(NOT OpenMP_CXX_FOUND)
    set(AABBtree_FOUND FALSE)
    set(AABBtree_NOT_FOUND_MESSAGE
      "AABBtree was built with OpenMP, but OpenMP was not found")
    return()
  endif()
endif()

# Import targets
include("${CMAKE_CURRENT_LIST_DIR}/AABBtreeTargets.cmake")

check_required_components(AABBtree)
