@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Dependencies
find_dependency(Eigen3 3.4)

# OpenMP is needed only if AABBtree was configured with it. The module shipped
# with the package also finds libomp when the compiler is Apple Clang.
set(AABBTREE_USE_OPENMP @AABBTREE_USE_OPENMP@)
if(AABBTREE_USE_OPENMP AND NOT TARGET OpenMP::OpenMP_CXX)
  include("${CMAKE_CURRENT_LIST_DIR}/AABBtreeOpenMP.cmake")
  if(NOT OpenMP_CXX_FOUND)
    set(AABBtree_FOUND FALSE)
    set(AABBtree_NOT_FOUND_MESSAGE
      "AABBtree was built with OpenMP, but OpenMP was not found")
    return()
  endif()
endif()

# Import targets
include("${CMAKE_CURRENT_LIST_DIR}/AABBtreeTargets.cmake")

check_required_components(AABBtree)
